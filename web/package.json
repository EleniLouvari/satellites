    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "github-slugger": "2.0.0",
    "marked": "18.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
